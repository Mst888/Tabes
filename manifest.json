{
  "manifest_version": 2,
  "name": "Tabes",
  "version": "1.0.0",
  "description": "Brings back the Zen Browser web sidebar panels feature. Add websites as sidebar panels for quick access.",
  "author": "Zen Sidebar Extension",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "glance/glance.html"
  ],
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle the Tabes sidebar"
    },
    "toggle-float": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle the floating bar over web pages"
    },
    "next-panel": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Switch to the next panel"
    },
    "previous-panel": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Switch to the previous panel"
    },
    "open-glance": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open the last panel as a Glance over the current page"
    }
  },
  "sidebar_action": {
    "default_title": "Tabes",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Tabes",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabes@extension",
      "strict_min_version": "109.0"
    }
  }
}
